{
  "version": 2,
  "builds": [
    {
      "src": "src/main.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb",
        "runtime": "python3.11"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/main.py"
    }
  ],
  "env": {
    "DATABASE_URL": "@database_url",
    "JWT_SECRET": "@jwt_secret",
    "JWT_ALGORITHM": "HS256",
    "JWT_EXPIRATION_DAYS": "7",
    "DEBUG": "False",
    "ALLOWED_ORIGINS": "@allowed_origins"
  }
}
